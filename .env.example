# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets.
#
# Only secrets and per-machine overrides belong here. Every other setting
# (ports, timeouts, limits, log level, ...) lives in config.yaml, which is
# committed to git. Anything set here overrides config.yaml, and a real
# environment variable overrides both.

# Postgres password (required).
DB_PASSWORD=change-me

# JWT signing secret (required, at least jwt.min_secret_length characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# Optional superadmin / bootstrap admin login. Leave both empty to disable.
# Generate the hash with: make gen-admin-hash
# It prompts for the password with echo off and reads it on a pipe, so the
# password never appears on a command line, in ps output or in shell history.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Grafana's admin password. Needed only by the monitoring stack, which is a
# second compose file rather than a profile - "make observability-up", or
# docker compose -f docker-compose.yml -f docker-compose.observability.yml up.
# There is no default. The API alone ("make docker-up") does not read it.
GRAFANA_PASSWORD=change-me
# GRAFANA_USER=admin
# Set to true to open the dashboards without logging in. Local only, and only
# while BIND_HOST is 127.0.0.1.
# GRAFANA_ANONYMOUS=false

# Which interface docker-compose.yml publishes its ports on. The default,
# 127.0.0.1, keeps the database, the API, Prometheus and Grafana reachable
# from this machine only. Use 0.0.0.0 for a demo on a trusted network.
# BIND_HOST=127.0.0.1

# Per-machine overrides of config.yaml, uncomment as needed:
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# LOG_LEVEL=debug
