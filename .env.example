# Copy to .env (git-ignored) and fill in real values.
# Only secrets and per-machine overrides belong here; other settings live in
# config.yaml. Precedence: environment > .env > config.yaml.

# Postgres password (required).
DB_PASSWORD=change-me

# JWT signing secret (required, at least jwt.min_secret_length characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# Optional bootstrap admin login; leave both empty to disable.
# Generate the hash with: make gen-admin-hash (prompts without echo).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Grafana admin password, required only by make observability-up. No default.
GRAFANA_PASSWORD=change-me
# GRAFANA_USER=admin
# true opens dashboards without login; only with BIND_HOST=127.0.0.1.
# GRAFANA_ANONYMOUS=false

# Interface for published ports. 0.0.0.0 exposes them to the network.
# BIND_HOST=127.0.0.1

# Per-machine overrides of config.yaml, uncomment as needed:
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# LOG_LEVEL=debug
