# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets (see the original project's configs/handler.yaml,
# which had the JWT secret and admin password hash committed to git; this
# rewrite is why that no longer happens).

APP_ENV=development

SERVER_ADDRESS=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=15s

DB_HOST=localhost
DB_PORT=5432
DB_NAME=to_do
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
JWT_TTL=1h
JWT_ISSUER=to-do-list

# Optional bootstrap admin login (leave both empty to disable it).
# Generate the hash with: go run ./cmd/hashpw 'your admin password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

CORS_ALLOW_ORIGINS=*

RUN_MIGRATIONS=true
MIGRATIONS_PATH=migrations

LOG_LEVEL=info
LOG_FORMAT=json
