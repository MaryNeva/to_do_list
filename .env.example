# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets.
#
# Only secrets and per-machine overrides belong here. Every other setting
# (ports, timeouts, limits, log level, ...) lives in config.yaml, which is
# committed to git. Anything set here overrides config.yaml, and a real
# environment variable overrides both.

# Postgres password (required).
DB_PASSWORD=change-me

# JWT signing secret (required, at least jwt.min_secret_length characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# Optional superadmin / bootstrap admin login. Leave both empty to disable.
# Generate the hash with: make gen-admin-hash pass='your admin password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Per-machine overrides of config.yaml, uncomment as needed:
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# LOG_LEVEL=debug
