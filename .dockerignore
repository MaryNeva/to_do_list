# Keep secrets (.env), git history and unrelated files out of the build context.

# Secrets and local configuration
.env
.env.*
!.env.example

# Version control
.git
.gitignore
.github

# Docker and deployment inputs that are mounted, not built in
deployments/grafana
deployments/prometheus
docker-compose.yml
docker-compose.observability.yml
Dockerfile
.dockerignore

# Build artifacts and local tooling
bin/
tmp/
*.exe
go.work
go.work.sum

# Test and coverage output
coverage.out
coverage.html

# Editor / IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local drafts and archives
*.tgz
*.tar.gz
Claude outputs/

# Documentation and scripts
README.md
LICENSE
docs/
api/
scripts/
