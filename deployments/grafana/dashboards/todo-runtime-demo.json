{
  "uid": "todo-runtime-demo",
  "title": "To-do | 3. Go runtime and PostgreSQL pool",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "to-do-list",
    "demo"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Connection pool utilization",
      "type": "timeseries",
      "description": "Acquired / maximum connections. Sustained saturation together with waits requires investigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(todo_db_pool_acquired_connections{job=\"to-do-list\"}) / sum(todo_db_pool_max_connections{job=\"to-do-list\"})",
          "legendFormat": "{{method}} {{route}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Pool connections",
      "type": "timeseries",
      "description": "Application pool only, not every PostgreSQL connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "todo_db_pool_acquired_connections{job=\"to-do-list\"}",
          "legendFormat": "acquired",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "todo_db_pool_idle_connections{job=\"to-do-list\"}",
          "legendFormat": "idle",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "todo_db_pool_total_connections{job=\"to-do-list\"}",
          "legendFormat": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "expr": "todo_db_pool_max_connections{job=\"to-do-list\"}",
          "legendFormat": "maximum",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Connection acquisition waits and cancellations",
      "type": "timeseries",
      "description": "Wait: pool empty. Cancellation: context ended before acquiring a connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(todo_db_pool_empty_acquires_total{job=\"to-do-list\"}[$__rate_interval])",
          "legendFormat": "waits/s",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(todo_db_pool_canceled_acquires_total{job=\"to-do-list\"}[$__rate_interval])",
          "legendFormat": "cancellations/s",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Mean connection acquisition duration",
      "type": "timeseries",
      "description": "Average per successful acquisition, not SQL query duration. Undefined without acquisitions.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(todo_db_pool_acquire_duration_seconds_total{job=\"to-do-list\"}[$__rate_interval])) / sum(rate(todo_db_pool_acquires_total{job=\"to-do-list\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Process RSS and Go heap memory",
      "type": "timeseries",
      "description": "Different memory measures. A single rise does not prove a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"to-do-list\"}",
          "legendFormat": "RSS",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "go_memstats_heap_inuse_bytes{job=\"to-do-list\"}",
          "legendFormat": "Go heap in use",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Process CPU usage in cores",
      "type": "timeseries",
      "description": "1 means one fully utilized CPU core; 0.1 means 10% of one core.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"to-do-list\"}[$__rate_interval])",
          "legendFormat": "CPU cores",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Goroutines",
      "type": "timeseries",
      "description": "Check whether the count returns to baseline after traffic stops.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"to-do-list\"}",
          "legendFormat": "goroutines",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Process uptime",
      "type": "stat",
      "description": "A reset indicates process restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=\"to-do-list\"}",
          "legendFormat": "uptime",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 9,
      "title": "Session cleanup runs",
      "type": "timeseries",
      "description": "Scheduled hourly. Zero over a 15-minute interval may be normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(todo_cleanup_runs_total{job=\"to-do-list\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Expired refresh tokens removed",
      "type": "timeseries",
      "description": "Zero is normal when no tokens have passed the retention cutoff.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(todo_cleanup_refresh_tokens_removed_total{job=\"to-do-list\"}[$__range])",
          "legendFormat": "removed",
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": [
