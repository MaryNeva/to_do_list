        {
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(todo_auth_refresh_rotations_total{outcome=\"reuse\"}[$__range]))",
          "legendFormat": "reuse",
          "range": true,
          "instant": false,
          "refId": "A"
