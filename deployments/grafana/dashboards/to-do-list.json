{
  "uid": "to-do-list-service",
  "title": "to-do-list service",
  "description": "RED metrics, authentication outcomes, connection pool and housekeeping for the to-do-list API.",
  "tags": [
    "to-do-list",
    "go"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "description": "Every request the service answered, including 4xx and 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(todo_http_requests_total[$__rate_interval]))",
          "legendFormat": "rps",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server error rate",
      "description": "Share of requests that failed inside the service. A rejected request (400/401/404/409) is a normal answer and is not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "todo-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "todo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(todo_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(todo_http_requests_total[$__rate_interval])), 0.0001)",
          "legendFormat": "5xx share",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
